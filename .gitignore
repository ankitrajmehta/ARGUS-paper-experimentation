# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Vendored upstream code (cloned, not ours — see scripts/setup_vendor.sh)
vendor/

# Experiment outputs. The per-scene result JSONs are small (123 files, 4.6 MB
# across every run) and are the actual evidence behind every number in the
# report, so they are tracked. What is excluded is the bulk: fetched archives
# and raw activation tensors, both regenerable, and both over GitHub's 100 MB
# per-file limit.
results/**/*.zip
results/**/*.npz
results/**/*.csv
results/**/*.png
results/**/*.jpg
!results/.gitkeep

# Downloaded model weights (anchored: must not match src/midas/models/)
/models/
*.ckpt
*.safetensors

# OS
.DS_Store

# Kaggle deploy staging (regenerated by scripts/kaggle_deploy.py)
kaggle/_staging/
kaggle/_kernel/

# Sweep kernel staging
kaggle/_kernel_sweep/

# DriveLM release: 3.5 GB of frames and a 193 MB QA file, both re-downloadable
# with scripts/fetch_drivelm.py. scenes.json is kept -- it is small and records
# exactly which 100 scenes an experiment used.
data/drivelm/nuscenes/
data/drivelm/*.json
!data/drivelm/scenes.json
data/drivelm/.cache/
